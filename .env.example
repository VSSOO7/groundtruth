# Copy to .env and fill in. NEVER commit .env.

# --- Database ---
DATABASE_URL=postgresql://groundtruth:groundtruth@localhost:5432/groundtruth

# --- Anthropic ---
# Get one at https://console.anthropic.com/settings/keys
# Model IDs are complete as written -- do NOT append date suffixes.
ANTHROPIC_API_KEY=
GENERATION_MODEL=claude-opus-5
JUDGE_MODEL=claude-opus-5
CHEAP_MODEL=claude-haiku-4-5
EFFORT=high

# --- Embeddings ---
EMBEDDING_MODEL=BAAI/bge-base-en-v1.5
EMBEDDING_DIM=768

# --- Retrieval ---
CANDIDATE_K=100
FINAL_K=8
RERANKER_PATH=models/reranker.ubj

# --- Ingestion ---
# SEC requires a descriptive User-Agent with contact info, or it returns 403.
# https://www.sec.gov/os/webmaster-faq#developers
SEC_USER_AGENT=groundtruth/0.1 (your-email@example.com)
CHUNK_TOKENS=512
CHUNK_OVERLAP_TOKENS=64

# --- Observability ---
LOG_LEVEL=INFO
OTEL_EXPORTER_OTLP_ENDPOINT=
